# Application runtime environment
APP_ENV=development

# Backend server configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# URL used by the React frontend to communicate with the backend
VITE_API_BASE_URL=http://127.0.0.1:8000

# Local PostgreSQL development configuration
POSTGRES_DB=cloud_operations
POSTGRES_USER=cloud_ops
POSTGRES_PASSWORD=cloud_ops_password
POSTGRES_PORT=5434

# SQLAlchemy connection URL for the local PostgreSQL database
DATABASE_URL=postgresql+psycopg://cloud_ops:cloud_ops_password@127.0.0.1:5434/cloud_operations

# JWT authentication configuration
JWT_SECRET_KEY=replace-with-a-secure-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=cloud-operations-api
JWT_AUDIENCE=cloud-operations-client
