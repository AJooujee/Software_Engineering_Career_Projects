# Production environment template
#
# Copy this file to .env.production and replace every placeholder before
# starting the production Compose stack. Never commit .env.production.

# PostgreSQL creates this database and application account on first startup.
POSTGRES_DB=observability
POSTGRES_USER=observability

# Replace this placeholder with a unique high-entropy database password.
# Avoid spaces and URL-reserved characters unless they are percent-encoded
# because Compose inserts this value into the SQLAlchemy connection URL.
POSTGRES_PASSWORD=replace-with-a-secure-database-password

# Replace this placeholder with an independently generated API credential.
# The application requires at least 32 characters and rejects known example
# values when OBSERVABILITY_ENVIRONMENT is production.
OBSERVABILITY_API_KEY=replace-with-a-secure-api-key

# Publish the container's port 8000 on this host port.
OBSERVABILITY_API_PORT=8000

# Supply every hostname that clients or the reverse proxy will send through
# the HTTP Host header. Pydantic reads this value as a JSON string list.
# Replace api.example.com with the actual production hostname.
OBSERVABILITY_TRUSTED_HOSTS=["api.example.com","localhost","127.0.0.1","api"]

# Allow this number of requests from one client during each fixed window.
OBSERVABILITY_RATE_LIMIT_REQUESTS=100

# Define the fixed rate-limit window duration in seconds.
OBSERVABILITY_RATE_LIMIT_WINDOW_SECONDS=60