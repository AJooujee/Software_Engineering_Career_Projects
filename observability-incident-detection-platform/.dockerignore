# Git history and editor metadata are not runtime inputs.
.git
.gitignore
.vscode
.idea

# Never copy local credentials into a container build context.
.env
.env.*
!.env.example

# Local Python environments and generated bytecode are host-specific.
.venv
venv
__pycache__
*.py[cod]
*.pyo

# Test, lint, and coverage caches are not needed in production.
.pytest_cache
.ruff_cache
.coverage
htmlcov
coverage.xml

# Documentation and local test suites do not belong in the runtime image.
docs
tests

# Docker and operating-system metadata are excluded from recursive contexts.
Dockerfile*
compose*.yaml
docker-compose*.yml
.DS_Store
Thumbs.db