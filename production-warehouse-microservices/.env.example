# Inventory PostgreSQL
POSTGRES_DB=inventory_db
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=change_me_inventory
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://inventory_user:change_me_inventory@localhost:5433/inventory_db

# Warehouse PostgreSQL
WAREHOUSE_POSTGRES_DB=warehouse_db
WAREHOUSE_POSTGRES_USER=warehouse_user
WAREHOUSE_POSTGRES_PASSWORD=change_me_warehouse
WAREHOUSE_POSTGRES_HOST=localhost
WAREHOUSE_POSTGRES_PORT=5434
WAREHOUSE_DATABASE_URL=postgresql+psycopg://warehouse_user:change_me_warehouse@localhost:5434/warehouse_db

# Order PostgreSQL
ORDER_POSTGRES_DB=order_db
ORDER_POSTGRES_USER=order_user
ORDER_POSTGRES_PASSWORD=change_me_order
ORDER_POSTGRES_HOST=localhost
ORDER_POSTGRES_PORT=5435
ORDER_DATABASE_URL=postgresql+psycopg://order_user:change_me_order@localhost:5435/order_db

# Order Service downstream dependencies
ORDER_INVENTORY_SERVICE_URL=http://127.0.0.1:8001
ORDER_WAREHOUSE_SERVICE_URL=http://127.0.0.1:8002
ORDER_SERVICE_REQUEST_TIMEOUT_SECONDS=5

# API Gateway downstream dependencies
GATEWAY_INVENTORY_SERVICE_URL=http://127.0.0.1:8001
GATEWAY_WAREHOUSE_SERVICE_URL=http://127.0.0.1:8002
GATEWAY_ORDER_SERVICE_URL=http://127.0.0.1:8003
GATEWAY_SERVICE_REQUEST_TIMEOUT_SECONDS=5

# Structured application logging
LOG_LEVEL=INFO